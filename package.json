{
  "name": "sudheer-cinematic-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:okf": "node scripts/build-okf.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "node scripts/build-okf.mjs && node scripts/prepare-assets.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:steve": "node --test tests/assistant.test.mjs",
    "test:steve:ui": "node scripts/verify-steve-ui.mjs",
    "test:steve:live": "node scripts/verify-steve-live.mjs",
    "check:steve:secrets": "node scripts/check-steve-secrets.mjs",
    "check:steve:readiness": "node scripts/check-steve-readiness.mjs",
