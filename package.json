    "test:steve:cv": "node scripts/verify-cv-modal.mjs"
  },
  "dependencies": {
    "@upstash/qstash": "^2.11.3",
    "lenis": "^1.3.11",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.0"
