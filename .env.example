PRIMARY_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_SEARCH_MODEL=gpt-6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=ash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VOICE=Charon
PORTFOLIO_ORIGIN=https://sudheercv.vercel.app
STEVE_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use your personally authorized calendar refresh token; do not use the company calendar token.
STEVE_GOOGLE_CLIENT_ID=
STEVE_GOOGLE_CLIENT_SECRET=
STEVE_GOOGLE_REFRESH_TOKEN=
STEVE_GOOGLE_CALENDAR_ID=

# Roll out independently after preview acceptance. No public VITE_ secrets.
STEVE_ENABLED=true
STEVE_SEARCH_ENABLED=false
STEVE_VOICE_ENABLED=false
STEVE_BOOKING_ENABLED=false
STEVE_DAILY_REQUEST_LIMIT=200
STEVE_DAILY_VOICE_LIMIT=20
STEVE_DAILY_CHAT_LIMIT=200
STEVE_DAILY_SEARCH_LIMIT=100
STEVE_BOOKINGS_PER_EMAIL_DAY=3
# Required for durable server-side voice cutoff; callback must be reachable by QStash.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional progressive challenge; without configuration, suspicious attempts are denied.
STEVE_TURNSTILE_SITE_KEY=
STEVE_TURNSTILE_SECRET=

# Redacted operational records in Redis expire after seven days.
STEVE_METRICS_ENABLED=true
