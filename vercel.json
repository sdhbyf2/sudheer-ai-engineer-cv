{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/assistant/chat.js": {
      "maxDuration": 60
    },
    "api/assistant/session.js": {
      "maxDuration": 60
    },
    "api/assistant/tools.js": {
      "maxDuration": 60
    },
    "api/assistant/voice.js": {
      "maxDuration": 60
    },
    "api/booking/confirm.js": {
      "maxDuration": 60
    },
    "api/booking/slots.js": {
      "maxDuration": 60
    },
    "api/assistant/voice-watchdog.js": {
      "maxDuration": 30
    },
    "api/assistant/lead.js": {
      "maxDuration": 60
    },
    "api/assistant/log.js": {
      "maxDuration": 60
    },
    "api/assistant/voice-end.js": {
      "maxDuration": 60
    },
    "api/booking/status.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cv-one-khaki.vercel.app"
        }
      ],
      "destination": "https://sudheercv.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Sudheer_Palakurla_AI_Engineer_CV.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://sc.lfeeder.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://sc.lfeeder.com; media-src 'self' blob:; connect-src 'self' https://api.openai.com https://challenges.cloudflare.com https://sc.lfeeder.com https://tr.lfeeder.com https://*.lfeeder.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
